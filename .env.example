# Contact form: endpoint of a third-party form service (Formspree-style JSON POST).
# Leave empty to fall back to a mailto: link.
NEXT_PUBLIC_FORM_ENDPOINT=
# Optional: Web3Forms access key (sent as `access_key` in the payload).
NEXT_PUBLIC_FORM_ACCESS_KEY=
# Public site URL, used for canonical/OG/sitemap. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
